---
import UnifiedLayout from '../../layouts/UnifiedLayout.astro';
import MapIntro from '../../components/MapIntro.astro';
import data from '../../data/sdl_data.json';
import uiAll from '../../i18n/ui.json';

const lang = 'ko';
const ui = uiAll[lang];
---

<UnifiedLayout title={`${ui.brandH1} ${ui.brandDim}`} lang={lang} activeView="map">
  <MapIntro lang={lang} />
  <iframe src="/map-legacy.html?embed=1&lang=ko" style="position:fixed;inset:0;width:100%;height:100%;border:none;display:block;background:var(--bg);" title="Interactive map of self-driving laboratories worldwide"></iframe>
</UnifiedLayout>
