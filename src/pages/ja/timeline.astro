---
import UnifiedLayout from '../../layouts/UnifiedLayout.astro';
import TimelineBody from '../../components/TimelineBody.astro';
import uiAll from '../../i18n/ui.json';

const lang = 'ja';
const ui = uiAll[lang];
---

<UnifiedLayout title={`${ui.timeline} · ${ui.brandH1} ${ui.brandDim}`} description={ui.timelineIntro} lang={lang} activeView="timeline">
  <TimelineBody lang={lang} />
</UnifiedLayout>
