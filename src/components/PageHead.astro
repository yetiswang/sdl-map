---
// Consistent page-identity block for the List / Timeline / Watch views.
// Title mirrors the active nav pill; one-line description in muted ink.
// Tokens only — see DESIGN.md. An optional right-aligned slot (e.g. RSS link).
interface Props { title: string; desc?: string }
const { title, desc } = Astro.props;
---

<header class="ph">
  <div class="ph-main">
    <h1 class="ph-title">{title}</h1>
    {desc && <p class="ph-desc">{desc}</p>}
  </div>
  <div class="ph-aside"><slot /></div>
</header>

<style>
  .ph { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px;
        margin: 0 0 24px; padding: 0 0 16px; border-bottom: 1px solid var(--rule); }
  .ph-title { margin: 0 0 6px; font-size: 22px; font-weight: 650; line-height: 1.2;
              letter-spacing: -0.01em; color: var(--ink); }
  .ph-desc { max-width: 62ch; margin: 0; font-size: 14px; line-height: 1.6; color: var(--ink-2); }
  .ph-aside { flex-shrink: 0; }
  @media (max-width: 640px) { .ph { flex-direction: column; align-items: flex-start; } }
</style>
